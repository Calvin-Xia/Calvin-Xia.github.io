---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import LicenseBadge from '../components/LicenseBadge.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
    blogEntryToItem,
    compareContentItems,
    dataEntryToItem,
    getUniqueValues,
    isFreshDate,
} from '../lib/content';
import { t } from '../lib/i18n.ts';

const [blogEntries, workEntries, toolEntries] = await Promise.all([
    getCollection('blog', ({ data }) => data.status !== 'draft'),
    getCollection('works', ({ data }) => data.status !== 'draft'),
    getCollection('tools', ({ data }) => data.status !== 'draft'),
]);

const articles = blogEntries.map(blogEntryToItem).sort(compareContentItems);
const searchableTypes = ['article', 'work', 'tool'];

const heroImages = import.meta.glob('../assets/hero/*.webp', { eager: true, import: 'default' });
const heroThumbs = {};
for (const [key, image] of Object.entries(heroImages)) {
    const fileName = key.split('/').pop();
    const { src } = await getImage({ src: image, width: 480, height: 270, fit: 'cover', format: 'webp' });
    heroThumbs[fileName] = src;
}

// Keyed by the hero filename the post declares in frontmatter, not by the article
// slug. The two only coincide by convention, so deriving one from the other silently
// orphans the thumbnail as soon as an article is renamed.
function heroThumbFor(item) {
    const heroFile = String(item.hero || '').trim();
    return heroFile ? heroThumbs[heroFile] || null : null;
}

const articlesWithThumbs = articles.map((item) => ({ ...item, thumb: heroThumbFor(item) }));
const categories = getUniqueValues(articles.map((item) => item.category));
const tags = getUniqueValues(articles.flatMap((item) => item.tags));

const payload = {
    articles: articlesWithThumbs,
    heroThumbs,
    searchableTypes,
};
---

<BaseLayout title={t('articles.pageTitle')} titleKey="articles.pageTitle" description={t('articles.description')} descriptionKey="articles.description" currentPage="articles">
    <div class="article-index-hero">
        <PageIntro
            kicker={t('articles.kicker')}
            kickerKey="articles.kicker"
            title={t('articles.title')}
            titleKey="articles.title"
            compact
        />

        <nav class="articles-toolbar" aria-label={t('articles.viewAria')} data-i18n-aria-label="articles.viewAria">
            {/* i18n source contract: 文章归档 */}
            <a href="/articles/archive/" class="btn btn-outline" data-i18n="articles.archive">{t('articles.archive')}</a>
        </nav>
    </div>

    <section id="content-search" class="section-stack articles-search-section" aria-label={t('articles.searchAria')} data-i18n-aria-label="articles.searchAria">
        <div class="search-container">
            <div class="search-box">
                <input
                    id="search-input"
                    type="search"
                    placeholder={t('articles.searchPlaceholder')}
                    data-i18n-placeholder="articles.searchPlaceholder"
                    autocomplete="off"
                    aria-label={t('articles.searchInputAria')}
                    data-i18n-aria-label="articles.searchInputAria"
                    aria-describedby="search-hint"
                    aria-controls="search-suggestions"
                    aria-autocomplete="list"
                    aria-expanded="false"
                />
                <button id="search-btn" class="search-btn" aria-label={t('articles.searchButtonAria')} data-i18n-aria-label="articles.searchButtonAria">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                </button>
            </div>
            <p id="search-hint" class="text-small search-hint" data-i18n="articles.searchHint">{t('articles.searchHint')}</p>
            <p id="content-search-status" class="text-small search-status" aria-live="polite"></p>
            <div
                id="search-suggestions"
                class="search-suggestions"
                role="listbox"
                aria-label={t('articles.searchSuggestionsAria')}
                data-i18n-aria-label="articles.searchSuggestionsAria"
            ></div>
            <div
                id="search-history-container"
                class="search-history-container"
                aria-label={t('articles.searchHistory')}
                data-i18n-aria-label="articles.searchHistory"
            ></div>
        </div>
    </section>

    <div id="article-filter-nav" class="filter-nav">
        <div class="filter-section">
            <h2 data-i18n="articles.categoryHeading">{t('articles.categoryHeading')}</h2>
            <div id="category-filters" class="filter-tags">
                <button class="filter-tag active" type="button" data-filter="all" data-type="category" aria-pressed="true" data-i18n="articles.allFilter">
                    {t('articles.allFilter')}
                </button>
                {categories.map((category) => (
                    <button class="filter-tag" type="button" data-filter={category} data-type="category" aria-pressed="false">
                        {category}
                    </button>
                ))}
            </div>
        </div>
        <div class="filter-section">
            <h2 data-i18n="articles.tagHeading">{t('articles.tagHeading')}</h2>
            <div id="tag-filters" class="filter-tags">
                <button class="filter-tag active" type="button" data-filter="all" data-type="tag" aria-pressed="true" data-i18n="articles.allFilter">
                    {t('articles.allFilter')}
                </button>
                {tags.map((tag) => (
                    <button class="filter-tag" type="button" data-filter={tag} data-type="tag" aria-pressed="false">
                        {tag}
                    </button>
                ))}
            </div>
        </div>
    </div>

    <section id="blog-container" aria-live="polite" aria-label={t('articles.listAria')} data-i18n-aria-label="articles.listAria">
        <div id="content-skeletons" class="skeleton-list" hidden>
            {Array.from({ length: 4 }).map(() => (
                <div class="skeleton-card" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            ))}
        </div>
        <div id="content-results" class="content-results">
            {articlesWithThumbs.map((article, index) => (
                <article class="blog-card content-card-enter" style={`--stagger-index: ${index}`}>
                    <a href={article.filePath} class="blog-card-link">
                        {article.thumb && (
                            <img
                                class="blog-card-thumb"
                                src={article.thumb}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                width="480"
                                height="270"
                            />
                        )}
                        <h2 class="blog-card-title">{article.title}</h2>
                        <p class="blog-card-excerpt">{article.excerpt}</p>
                    </a>
                    <div class="blog-card-meta">
                        {isFreshDate(article.date) && (
                            <span class="content-type-badge content-type-badge--new" data-i18n="common.new">{t('common.new')}</span>
                        )}
                        <span class="blog-card-category">{article.category}</span>
                        {article.tags.map((tag) => <span class="blog-card-tag">{tag}</span>)}
                    </div>
                    <div class="blog-card-date blog-card-date-row">
                        <span>{article.date}</span>
                        {article.readingStats && (
                            <span class="blog-card-reading-stats">
                                {article.readingStats.wordCountDisplay} · {article.readingStats.readTimeDisplay}
                            </span>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <div class="license-section">
        <LicenseBadge />
    </div>

    <div class="page-return">
        <a
            href="/"
            class="btn btn-secondary"
            data-history="true"
            data-title={t('nav.home')}
            data-i18n-data-title="nav.home"
        >
            ← <span data-i18n="common.backHome">{t('common.backHome')}</span>
        </a>
    </div>
</BaseLayout>

<script id="content-search-data" type="application/json" set:html={JSON.stringify(payload)}></script>
<script>
    import { t } from '../lib/i18n.ts';
    import {
        addToSearchHistory,
        debounce,
        formatSearchResult,
        loadSearchIndex,
        renderSearchHistory,
        search as searchContent,
    } from '../lib/search-client.ts';
    import { isFreshDate } from '../lib/shared-content.js';
    import { createContentCard, renderNoResults, showSkeletonThen } from '../scripts/articles-index/cards.js';
    import {
        getFilteredArticles,
        resetFilterButtons,
        selectFilterButton,
        setActiveFilter,
        setFilterVisibility,
    } from '../scripts/articles-index/filters.js';
    import { contentTypeLabel, heroThumbFor, parseContentSearchPayload } from '../scripts/articles-index/payload.js';
    import {
        createSuggestionElement,
        hideSearchHistory,
        hideSuggestions as clearSuggestions,
        setSearchStatus,
        updateSuggestionSelection,
    } from '../scripts/articles-index/search.js';

    (() => {
        const payload = parseContentSearchPayload();
        const searchableTypes = new Set(payload.searchableTypes || []);
        const state = {
            currentCategory: 'all',
            currentTag: 'all',
            searchQuery: '',
            isSearchMode: false,
            searchRequestId: 0,
            suggestionRequestId: 0,
            selectedSuggestionIndex: -1,
            suggestionItems: [],
        };

        const searchInput = document.getElementById('search-input');
        const searchBtn = document.getElementById('search-btn');
        const suggestionsContainer = document.getElementById('search-suggestions');
        const historyContainer = document.getElementById('search-history-container');
        const resultsContainer = document.getElementById('content-results');
        const skeletons = document.getElementById('content-skeletons');
        const filterNav = document.getElementById('article-filter-nav');
        const searchStatus = document.getElementById('content-search-status');
        const categoryContainer = document.getElementById('category-filters');
        const tagContainer = document.getElementById('tag-filters');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const contentTypeKeys = {
            article: 'contentTypes.article',
            work: 'contentTypes.work',
            tool: 'contentTypes.tool',
            'update-log': 'contentTypes.update-log',
        };
        const heroThumbs = payload.heroThumbs || {};

        async function getSearchResults(query, options = {}) {
            const index = await loadSearchIndex();
            return searchContent(index, query, {
                types: Array.from(searchableTypes),
                ...options,
            });
        }

        function updateUrlFromState() {
            const params = new URLSearchParams(window.location.search);

            params.delete('q');
            params.delete('category');
            params.delete('tag');

            if (state.searchQuery) {
                params.set('q', state.searchQuery);
            }

            if (state.currentCategory !== 'all') {
                params.set('category', state.currentCategory);
            }

            if (state.currentTag !== 'all') {
                params.set('tag', state.currentTag);
            }

            const queryString = params.toString();
            const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`;
            history.replaceState(history.state, '', nextUrl);
        }

        function renderCards(items, options = {}) {
            if (!resultsContainer) {
                return;
            }

            resultsContainer.innerHTML = '';
            items.forEach((item, index) => {
                resultsContainer.append(createContentCard(item, {
                    ...options,
                    index,
                    fresh: isFreshDate(item.date),
                    thumbSource: heroThumbFor(item, heroThumbs),
                    typeLabel: contentTypeLabel(item.type, contentTypeKeys),
                }));
            });
        }

        function getCurrentSearchFilters() {
            return {
                category: state.currentCategory === 'all' ? '' : state.currentCategory,
                tag: state.currentTag === 'all' ? '' : state.currentTag,
            };
        }

        function showSearchHistory() {
            if (!historyContainer || searchInput.value.trim()) {
                return;
            }

            renderSearchHistory(
                historyContainer,
                (query) => {
                    searchInput.value = query;
                    hideSearchHistory(historyContainer);
                    void performSearch();
                },
                {
                    title: t('articles.searchHistory'),
                    clear: t('articles.clearSearchHistory'),
                },
            );
        }

        function resetAllFilters() {
            searchInput.value = '';
            state.currentCategory = 'all';
            state.currentTag = 'all';
            resetFilterButtons(categoryContainer);
            resetFilterButtons(tagContainer);
            restoreArticleView();
        }

        function renderArticleList() {
            const filtered = getFilteredArticles(payload.articles, state);
            if (!filtered.length) {
                renderNoResults(resultsContainer, { onReset: resetAllFilters });
                return;
            }

            renderCards(filtered, { mixed: false });
        }

        function restoreArticleView() {
            state.searchRequestId += 1;
            state.isSearchMode = false;
            state.searchQuery = '';
            setFilterVisibility(filterNav, true, searchInput);
            setSearchStatus(searchStatus, '');
            updateUrlFromState();
            showSkeletonThen(resultsContainer, skeletons, renderArticleList, reducedMotion);
        }

        async function performSearch({ updateUrl = true } = {}) {
            const query = searchInput.value.trim();
            hideSuggestions();
            hideSearchHistory(historyContainer);
            state.searchQuery = query;
            const requestId = ++state.searchRequestId;

            if (!query) {
                restoreArticleView();
                return;
            }

            state.isSearchMode = true;
            setFilterVisibility(filterNav, true, searchInput);
            setSearchStatus(searchStatus, t('articles.searching'));
            addToSearchHistory(query);

            if (updateUrl) {
                updateUrlFromState();
            }

            let results = [];

            try {
                results = await getSearchResults(query, getCurrentSearchFilters());
            } catch (error) {
                if (requestId !== state.searchRequestId) {
                    return;
                }

                console.warn('Unable to load search index.', error);
                setSearchStatus(searchStatus, t('articles.searchUnavailable'));
                renderNoResults(resultsContainer, { onReset: resetAllFilters });
                return;
            }

            if (requestId !== state.searchRequestId) {
                return;
            }

            const formattedResults = results.map((result) => formatSearchResult(result, query));

            setSearchStatus(searchStatus, t('articles.searchResultCount', { query, count: formattedResults.length }));

            showSkeletonThen(resultsContainer, skeletons, () => {
                if (!formattedResults.length) {
                    renderNoResults(resultsContainer, { onReset: resetAllFilters });
                    return;
                }

                renderCards(formattedResults, { mixed: true, highlighted: true });
            }, reducedMotion);
        }

        async function showSuggestions(query) {
            const requestId = ++state.suggestionRequestId;
            let suggestions = [];

            try {
                suggestions = await getSearchResults(query, { limit: 6 });
            } catch (error) {
                if (requestId === state.suggestionRequestId) {
                    console.warn('Unable to load search suggestions.', error);
                    hideSuggestions();
                }
                return;
            }

            if (requestId !== state.suggestionRequestId) {
                return;
            }

            suggestionsContainer.innerHTML = '';
            state.suggestionItems = [];

            if (!suggestions.length) {
                hideSuggestions();
                return;
            }

            state.suggestionItems = suggestions.map((item, index) => {
                const suggestion = createSuggestionElement(item, index, query, {
                    label: contentTypeLabel(item.type, contentTypeKeys),
                    onNavigate: () => {
                        window.location.href = item.filePath;
                    },
                });
                suggestionsContainer.append(suggestion);
                return suggestion;
            });

            state.selectedSuggestionIndex = -1;
            suggestionsContainer.classList.add('active');
            searchInput.setAttribute('aria-expanded', 'true');
        }

        function hideSuggestions() {
            clearSuggestions(state, suggestionsContainer, searchInput);
        }

        const debouncedPerformSearch = debounce(() => {
            void performSearch();
        }, 300);

        const debouncedShowSuggestions = debounce((query) => {
            void showSuggestions(query);
        }, 180);

        function handleFilterClick(event) {
            const button = event.currentTarget;
            const filterValue = button.dataset.filter;
            const filterType = button.dataset.type;
            const container = filterType === 'category' ? categoryContainer : tagContainer;

            selectFilterButton(container, button);

            if (filterType === 'category') {
                state.currentCategory = filterValue;
            } else {
                state.currentTag = filterValue;
            }

            updateUrlFromState();

            if (state.isSearchMode && state.searchQuery) {
                void performSearch({ updateUrl: false });
                return;
            }

            showSkeletonThen(resultsContainer, skeletons, renderArticleList, reducedMotion);
        }

        function restoreStateFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const query = (params.get('q') || '').trim();

            state.currentCategory = setActiveFilter(categoryContainer, params.get('category') || 'all');
            state.currentTag = setActiveFilter(tagContainer, params.get('tag') || 'all');
            state.searchQuery = query;
            searchInput.value = query;

            if (query) {
                void performSearch({ updateUrl: false });
                return;
            }

            if (state.currentCategory !== 'all' || state.currentTag !== 'all') {
                renderArticleList();
            }
        }

        function bindEvents() {
            categoryContainer?.querySelectorAll('.filter-tag').forEach((button) => {
                button.addEventListener('click', handleFilterClick);
            });
            tagContainer?.querySelectorAll('.filter-tag').forEach((button) => {
                button.addEventListener('click', handleFilterClick);
            });

            searchInput.addEventListener('input', (event) => {
                const query = event.target.value.trim();
                hideSearchHistory(historyContainer);

                if (!query) {
                    debouncedShowSuggestions.cancel();
                    hideSuggestions();
                    restoreArticleView();
                    showSearchHistory();
                    return;
                }

                debouncedShowSuggestions(query);
                debouncedPerformSearch();
            });

            searchInput.addEventListener('focus', () => {
                showSearchHistory();
            });

            searchInput.addEventListener('keydown', (event) => {
                if (!state.suggestionItems.length || !suggestionsContainer.classList.contains('active')) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        void performSearch();
                    }
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    state.selectedSuggestionIndex = Math.min(state.selectedSuggestionIndex + 1, state.suggestionItems.length - 1);
                    updateSuggestionSelection(state, searchInput);
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    state.selectedSuggestionIndex = Math.max(state.selectedSuggestionIndex - 1, 0);
                    updateSuggestionSelection(state, searchInput);
                } else if (event.key === 'Enter' && state.selectedSuggestionIndex >= 0) {
                    event.preventDefault();
                    state.suggestionItems[state.selectedSuggestionIndex].click();
                } else if (event.key === 'Enter') {
                    event.preventDefault();
                    void performSearch();
                } else if (event.key === 'Escape') {
                    hideSuggestions();
                }
            });

            searchBtn.addEventListener('click', () => {
                void performSearch();
            });

            window.addEventListener('calvin-lang-change', () => {
                hideSuggestions();
                if (state.isSearchMode && state.searchQuery) {
                    void performSearch({ updateUrl: false });
                    return;
                }
                renderArticleList();
            });

            document.addEventListener('click', (event) => {
                if (
                    !searchInput.contains(event.target)
                    && !suggestionsContainer.contains(event.target)
                    && !historyContainer?.contains(event.target)
                ) {
                    hideSuggestions();
                    hideSearchHistory(historyContainer);
                }
            });
        }

        if (searchInput && searchBtn && suggestionsContainer && historyContainer && resultsContainer) {
            bindEvents();
            restoreStateFromUrl();

            if (window.location.hash === '#content-search') {
                requestAnimationFrame(() => searchInput.focus());
            }
        }
    })();
</script>
