---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import ArticleToc from '../../components/ArticleToc.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import LicenseBadge from '../../components/LicenseBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isFreshDate } from '../../lib/content';
import { t } from '../../lib/i18n.ts';
import { buildBlogPostingJsonLd } from '../../lib/site-seo.js';
import { computeReadingStats } from '../../lib/word-count.js';

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => data.status !== 'draft');

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingStats = computeReadingStats(post.body);
const readTimeDisplay = post.data.readTime || readingStats.readTimeDisplay;

const heroImages = import.meta.glob('../../assets/hero/*.webp', { eager: true, import: 'default' });
const heroImage = post.data.hero ? heroImages[`../../assets/hero/${post.data.hero}`] : null;

const canonical = new URL(`/articles/${post.id}/`, Astro.site).toString();
const ogImagePath = new URL(`/og/${post.id}.png`, Astro.site).toString();
const blogPostingJsonLd = JSON.stringify(buildBlogPostingJsonLd({
    title: post.data.title,
    description: post.data.excerpt,
    canonical,
    image: ogImagePath,
    datePublished: post.data.date,
}));
---

<BaseLayout
    title={`${post.data.title} - Calvin Xia`}
    description={post.data.excerpt}
    currentPage="articles"
    ogImage={ogImagePath}
    ogType="article"
    publishedTime={post.data.date}
>
    <article class="article-detail section-stack">
        <div class="page-return article-return">
            <a
                href="/articles/"
                class="btn btn-secondary"
                data-history="true"
                data-title={t('nav.articles')}
                data-i18n-data-title="nav.articles"
            >
                ← <span data-i18n="common.backArticles">{t('common.backArticles')}</span>
            </a>
        </div>

        {heroImage && (
            <figure class="article-cover">
                <img
                    src={heroImage.src}
                    width={heroImage.width}
                    height={heroImage.height}
                    alt={post.data.title}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </figure>
        )}

        <header class="page-intro article-hero">
            <p class="section-kicker">{post.data.category}</p>
            <h1 class="page-title">{post.data.title}</h1>
            <p class="page-subtitle">{post.data.excerpt}</p>
            <div class="blog-card-meta article-meta">
                {isFreshDate(post.data.date) && (
                    <span class="content-type-badge content-type-badge--new" data-i18n="common.new">{t('common.new')}</span>
                )}
                <span class="blog-card-category">{post.data.category}</span>
                {post.data.tags.map((tag) => <span class="blog-card-tag">{tag}</span>)}
                <span class="blog-card-date article-date">{post.data.date}</span>
                <span class="blog-card-date article-date">{readingStats.wordCountDisplay}</span>
                <span class="blog-card-date article-date">{readTimeDisplay}</span>
                <span class="view-count view-count--pending" data-view-counter data-slug={post.id} aria-live="polite" data-i18n="articleDetail.viewsLoading">
                    {t('articleDetail.viewsLoading')}
                </span>
                <button type="button" class="article-share-btn" id="article-share-btn" data-share-title={post.data.title} data-share-image={`/og/${post.id}.png`} data-i18n-aria-label="articleDetail.share">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    <span data-i18n="articleDetail.share">{t('articleDetail.share')}</span>
                </button>
            </div>
        </header>

        <div class="article-reading-layout">
            <section class="markdown-container" aria-label={t('articleDetail.bodyAria')} data-i18n-aria-label="articleDetail.bodyAria">
                <div class="markdown-content">
                    <Content />
                </div>
            </section>
            <ArticleToc />
        </div>
        <script type="application/ld+json" set:html={blogPostingJsonLd} />
        <GiscusComments />
        <footer class="license-section">
            <LicenseBadge />
        </footer>
    </article>
    <script>
        import { t } from '../../lib/i18n.ts';

        function initArticleShareButton() {
            const button = document.getElementById('article-share-btn');
            if (!button || button.dataset.shareBound === 'true') {
                return;
            }
            button.dataset.shareBound = 'true';

            button.addEventListener('click', async () => {
                const shareTitle = button.dataset.shareTitle || document.title;
                const shareUrl = window.location.href;

                try {
                    // Prefer sharing the OG card as an image file (richer share targets).
                    if (button.dataset.shareImage && navigator.canShare) {
                        try {
                            const response = await fetch(new URL(button.dataset.shareImage, window.location.origin));
                            const blob = await response.blob();
                            const fileName = `${(button.dataset.shareImage.split('/').pop() || 'share').replace(/\.[a-z0-9]+$/i, '')}.png`;
                            const file = new File([blob], fileName, { type: blob.type || 'image/png' });
                            if (file.size > 0 && navigator.canShare({ files: [file] })) {
                                await navigator.share({ files: [file], title: shareTitle, text: shareTitle });
                                return;
                            }
                        } catch (error) {
                            if (error?.name === 'AbortError') {
                                return;
                            }
                            // Fall through to link sharing.
                        }
                    }

                    if (navigator.share) {
                        await navigator.share({ title: shareTitle, url: shareUrl });
                        return;
                    }

                    await navigator.clipboard.writeText(shareUrl);
                    const label = button.querySelector('span');
                    if (label) {
                        const original = label.textContent;
                        label.textContent = t('articleDetail.shareCopied');
                        window.setTimeout(() => {
                            label.textContent = original;
                        }, 2000);
                    }
                } catch (error) {
                    if (error?.name !== 'AbortError') {
                        console.error('Share failed:', error);
                    }
                }
            });
        }

        initArticleShareButton();
        document.addEventListener('astro:page-load', initArticleShareButton);
    </script>
</BaseLayout>
