---
import { t } from '../lib/i18n.ts';
---

<div class="giscus-comments">
    {/* i18n source contract: 评论加载中… */}
    <p class="giscus-placeholder" data-i18n="comments.loading">{t('comments.loading')}</p>
    <div class="giscus"></div>
</div>

<!-- data-astro-rerun: Astro's router executes this loader only once per session. Without the
     attribute every client-side navigation into another article swaps in an empty .giscus mount
     that giscus never revisits, leaving the comments blank until a full reload. -->
<script
        is:inline
        data-astro-rerun
        src="https://giscus.app/client.js"
        data-repo="Calvin-Xia/Calvin-Xia.github.io"
        data-repo-id="R_kgDOQimLyw"
        data-category="Show and tell"
        data-category-id="DIC_kwDOQimLy84C8XWc"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async>
</script>

<script is:inline>
    (() => {
        function getGiscusTheme() {
            return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        }

        function updateGiscusTheme(iframe) {
            iframe = iframe || document.querySelector('iframe.giscus-frame');
            if (!iframe || !iframe.contentWindow) {
                return;
            }

            try {
                const { origin } = new URL(iframe.src);
                if (origin !== 'https://giscus.app') {
                    return;
                }
            } catch {
                return;
            }

            if (iframe.classList.contains('giscus-frame--loading') && iframe.dataset.giscusReady !== 'true') {
                return;
            }

            iframe.contentWindow.postMessage(
                {
                    giscus: {
                        setConfig: {
                            theme: getGiscusTheme(),
                        },
                    },
                },
                'https://giscus.app',
            );
        }

        function revealComments(iframe) {
            const container = iframe.closest('.giscus-comments');
            if (container) {
                container.classList.remove('is-loading');
                container.classList.add('is-ready');
            }
        }

        function bindGiscusFrame(iframe) {
            if (iframe.dataset.giscusReadyListener === 'true') {
                return;
            }

            iframe.dataset.giscusReadyListener = 'true';

            const onFrameReady = () => {
                iframe.dataset.giscusReady = 'true';
                revealComments(iframe);
                updateGiscusTheme(iframe);
            };

            if (iframe.classList.contains('giscus-frame--loading')) {
                iframe.addEventListener('load', onFrameReady, { once: true });
            } else {
                onFrameReady();
            }
        }

        function collectGiscusFrames(node) {
            if (!(node instanceof Element)) {
                return;
            }

            if (node.classList.contains('giscus-frame')) {
                bindGiscusFrame(node);
                return;
            }

            node.querySelectorAll('iframe.giscus-frame').forEach(bindGiscusFrame);
        }

        function scanForGiscusFrames() {
            document.querySelectorAll('iframe.giscus-frame').forEach(bindGiscusFrame);
        }

        // giscus resolves '.giscus' once per script execution and never observes the DOM again, so
        // watch for frames instead of racing them with a fixed retry budget.
        const observer = new MutationObserver((records) => {
            records.forEach((record) => {
                record.addedNodes.forEach(collectGiscusFrames);
            });
        });

        observer.observe(document.documentElement, { childList: true, subtree: true });

        document.querySelectorAll('.giscus-comments:not(.is-ready)').forEach((container) => {
            container.classList.add('is-loading');
        });

        scanForGiscusFrames();
        window.addEventListener('calvin-theme-change', () => updateGiscusTheme());
        document.addEventListener('astro:page-load', () => {
            document.querySelectorAll('.giscus-comments:not(.is-ready)').forEach((container) => {
                container.classList.add('is-loading');
            });
            scanForGiscusFrames();
            updateGiscusTheme();
        });
    })();
</script>

<noscript>
    {/* i18n source contract: 请启用 JavaScript 以加载评论功能。 */}
    <p class="giscus-fallback" data-i18n="comments.noscript">{t('comments.noscript')}</p>
</noscript>
