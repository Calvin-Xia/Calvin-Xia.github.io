{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mr-xia-site",
    "main": "src/worker.ts",
    "compatibility_date": "2026-04-28",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "vars": {
        "UMAMI_HOST": "https://umami.calvin-xia.cn",
        "UMAMI_WEBSITE_ID": "48c8309d-6ae9-4050-ac2c-cc5b127950a8"
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}
